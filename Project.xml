<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://lime.openfl.org/project/1.0.4">

	<meta title="Strand" package="com.buatedz.strand" version="0.1.0" company="buatedz" />
	<app main="Main" file="Strand" path="export" preloader="flixel.system.FlxPreloader" />

	<window width="1280" height="720" fps="60" background="#101114" hardware="true" vsync="false" resizable="true" allow-high-dpi="true" />
	<window if="desktop" orientation="landscape" fullscreen="false" />

	<source path="source" />

	<haxelib name="flixel" />
	<haxelib name="hxluajit" />

	<assets path="embed" rename="embed" embed="true" />

	<postbuild cmd="xcopy assets export\windows\bin\assets\ /E /I /Y /Q" if="windows" />

	<haxedef name="FLX_NO_TOUCH" />
	<haxedef name="FLX_NO_GAMEPAD" />
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
	<haxedef name="FLX_NO_DEBUG" unless="debug" />
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />
	<haxedef name="HXCPP_GC_GENERATIONAL" />
	<haxedef name="analyzer-optimize" />
	<haxedef name="message.reporting" value="pretty" />

	<icon path="embed/icon.png" if="windows" />
</project>
